# Copy to .env (ignored by git) and fill in. The tools and the tests read a value from the environment first, then
# from .env; one KEY=value per line.

# The folder the theme-pack tool reads and writes: themes/, out/, and bin/ with makerom and ctrtool
# (tools/theme-pack/README.md, "Data dir")
THEME_PACK_DATA=/path/to/theme-pack-data

# The folder the badges tool works in (tools/badges/README.md, "Data dir")
BADGES_DATA=/path/to/badges-data
